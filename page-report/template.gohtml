{{ define "table" -}}
<div class="kumbuka-page-report kumbuka-table-scroll">
  <table class="kumbuka-page-report-table">
    <thead>
      <tr>
        {{ range .Columns }}
          <th>{{ .Label }}</th>
        {{ end }}
      </tr>
    </thead>
    <tbody>
      {{ range .Rows }}
        <tr>
          {{ $url := .URL }}
          {{ range $index, $cell := .Cells }}
            <td>
              {{ if eq $index 0 }}
                <a href="{{ $url }}">{{ $cell }}</a>
              {{ else }}
                {{ $cell }}
              {{ end }}
            </td>
          {{ end }}
        </tr>
      {{ else }}
        <tr>
          <td colspan="{{ len .Columns }}">
            <span class="muted">{{ .EmptyMessage }}</span>
          </td>
        </tr>
      {{ end }}
    </tbody>
  </table>
</div>
{{- end }}

{{ define "list" -}}
<div class="kumbuka-page-report">
  <ul class="kumbuka-page-report-list">
    {{ range .Rows }}
      <li>
        <a href="{{ .URL }}">{{ index .Cells 0 }}</a>
        {{ range $index, $cell := .Cells }}
          {{ if gt $index 0 }}
            <span>{{ $cell }}</span>
          {{ end }}
        {{ end }}
      </li>
    {{ else }}
      <li class="muted">{{ .EmptyMessage }}</li>
    {{ end }}
  </ul>
</div>
{{- end }}

{{ define "cards" -}}
<div class="kumbuka-page-report kumbuka-page-report-cards">
  {{ range .Rows }}
    <a class="kumbuka-page-report-card" href="{{ .URL }}">
      <strong>{{ index .Cells 0 }}</strong>
      {{ range $index, $cell := .Cells }}
        {{ if gt $index 0 }}
          <span>{{ $cell }}</span>
        {{ end }}
      {{ end }}
    </a>
  {{ else }}
    <p class="muted">{{ .EmptyMessage }}</p>
  {{ end }}
</div>
{{- end }}

