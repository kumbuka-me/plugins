{{ define "subpage-entry" }}
  <li class="subpage-toc-item">
    {{ if .Page }}
      <a class="subpage-toc-link" href="{{ .URL }}">
        {{ if .Icon }}<span class="subpage-toc-node-icon" aria-hidden="true">{{ icon .Icon 17 }}</span>{{ end }}
        <span>{{ .Title }}</span>
      </a>
    {{ else }}
      <span class="subpage-toc-label">
        {{ if .Icon }}<span class="subpage-toc-node-icon" aria-hidden="true">{{ icon .Icon 17 }}</span>{{ end }}
        <span>{{ .Title }}</span>
      </span>
    {{ end }}
    {{ if .Children }}
      <ul class="subpage-toc-list">
        {{ range .Children }}{{ template "subpage-entry" . }}{{ end }}
      </ul>
    {{ end }}
  </li>
{{ end }}

{{ define "subpage-toc" }}
  {{ if .Children }}
    <nav class="subpage-toc" aria-label="Pages in this section">
      {{ if .ShowTitle }}
        <div class="subpage-toc-heading">
          <span aria-hidden="true">{{ icon "list-tree-lucide" 18 }}</span>
          <h2>{{ .Title }}</h2>
        </div>
      {{ end }}
      <ul class="subpage-toc-list subpage-toc-root">
        {{ range .Children }}{{ template "subpage-entry" . }}{{ end }}
      </ul>
    </nav>
  {{ end }}
{{ end }}
