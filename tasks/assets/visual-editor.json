{
  "version": 1,
  "widgets": [
    {
      "id": "tasks",
      "name": "Tasks",
      "inline": false,
      "syntax": {
        "kind": "macro",
        "name": "tasks"
      },
      "attributes": [
        {
          "name": "texts",
          "type": "list",
          "required": true,
          "max_bytes": 512,
          "max_items": 128,
          "separator": "\u001f"
        },
        {
          "name": "ids",
          "type": "list",
          "required": true,
          "max_bytes": 128,
          "max_items": 128,
          "separator": "\u001f"
        },
        {
          "name": "parents",
          "type": "list",
          "max_bytes": 128,
          "max_items": 128,
          "separator": "\u001f"
        },
        {
          "name": "assignees",
          "type": "list",
          "max_bytes": 128,
          "max_items": 128,
          "separator": "\u001f"
        },
        {
          "name": "dues",
          "type": "list",
          "max_bytes": 10,
          "max_items": 128,
          "separator": "\u001f"
        },
        {
          "name": "initials",
          "type": "list",
          "max_bytes": 64,
          "max_items": 128,
          "separator": "\u001f"
        }
      ],
      "settings": [
        {
          "type": "table",
          "label": "Tasks and subtasks",
          "attributes": [
            "texts",
            "ids",
            "parents",
            "assignees",
            "dues",
            "initials"
          ],
          "columns": [
            {
              "label": "Task",
              "type": "textarea"
            },
            {
              "label": "ID",
              "type": "text"
            },
            {
              "label": "Parent task ID",
              "type": "text"
            },
            {
              "label": "Assignee",
              "type": "text"
            },
            {
              "label": "Due",
              "type": "text"
            },
            {
              "label": "Initial state",
              "type": "text"
            }
          ]
        }
      ],
      "constraints": [
        {
          "kind": "same-length",
          "attributes": ["texts", "ids"]
        }
      ],
      "preview": {
        "kind": "card",
        "card": {
          "class": "kumbuka-task-list-editor",
          "title": "Tasks",
          "body_text": "Edit every task, subtask, and deeper nested task in one modal. Set Parent task ID to nest a row under an earlier task.",
          "rendered": true
        }
      }
    },
    {
      "id": "task",
      "name": "Task",
      "inline": false,
      "syntax": {
        "kind": "macro",
        "name": "task"
      },
      "attributes": [
        {
          "name": "id",
          "type": "identifier",
          "required": true,
          "max_bytes": 128
        },
        {
          "name": "text",
          "type": "string",
          "required": true,
          "max_bytes": 512
        },
        {
          "name": "assignee",
          "type": "string",
          "max_bytes": 128
        },
        {
          "name": "due",
          "type": "string",
          "max_bytes": 10
        },
        {
          "name": "initial",
          "type": "string",
          "max_bytes": 64
        },
        {
          "name": "parent",
          "type": "identifier",
          "max_bytes": 128
        }
      ],
      "settings": [
        {
          "type": "text",
          "label": "Task",
          "attribute": "text",
          "placeholder": "Describe the task"
        },
        {
          "type": "text",
          "label": "ID",
          "attribute": "id",
          "placeholder": "task-id"
        },
        {
          "type": "mention",
          "label": "Assignee",
          "attribute": "assignee",
          "placeholder": "@alice"
        },
        { "type": "date", "label": "Due", "attribute": "due" },
        {
          "type": "text",
          "label": "Initial state ID",
          "attribute": "initial",
          "placeholder": "open",
          "suggestions": ["open", "done"]
        },
        {
          "type": "text",
          "label": "Parent task ID",
          "attribute": "parent",
          "placeholder": "parent-task-id"
        }
      ],
      "preview": {
        "kind": "card",
        "card": {
          "class": "kumbuka-task",
          "title": "Task",
          "subtitle_attribute": "text",
          "metadata_attributes": ["assignee", "due", "initial", "parent"],
          "body_text": "Single-task syntax remains supported for existing pages. New task lists can be edited together in one modal."
        }
      }
    }
  ]
}
