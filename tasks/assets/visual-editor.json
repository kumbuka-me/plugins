          "max_bytes": 512
        },
        {
          "name": "description",
          "type": "string",
          "max_bytes": 4096
        },
        {
          "name": "assignee",
          "type": "string",
          "max_bytes": 128
        },
        {
          "name": "due",
          "type": "string",
          "max_bytes": 10
        },
        {
          "name": "initial",
          "type": "string",
          "max_bytes": 64
        },
        {
          "name": "parent",
          "type": "identifier",
          "max_bytes": 128
        }
      ],
      "settings": [
        {
          "type": "resource",
          "label": "Workflow group",
          "attribute": "workflow",
          "placeholder": "Use the default workflow…",
          "completion_module_id": "workflow-completion"
        },
        {
          "type": "text",
          "label": "Task",
          "attribute": "text",
          "placeholder": "Describe the task"
        },
        {
          "type": "textarea",
          "label": "Description",
