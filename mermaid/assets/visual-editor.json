      ],
      "settings": [
        {
          "type": "browser",
          "label": "Mermaid",
          "attribute": "body",
          "browser_module_id": "diagrams"
        }
      ],
      "preview": {
        "kind": "card",
        "card": {
          "class": "mermaid-editor-card",
          "title": "Mermaid diagram",
          "subtitle_attribute": "body",
          "body_text": "Edit the diagram source and alignment."
        }
      }
    }
  ]
}
