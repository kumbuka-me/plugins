{
  "version": 1,
  "widgets": [
    {
      "id": "details",
      "name": "Collapsible details",
      "inline": false,
      "syntax": {
        "kind": "details"
      },
      "attributes": [
        {
          "name": "title",
          "type": "string",
          "required": true,
          "max_bytes": 256
        },
        {
          "name": "open",
          "type": "enum",
          "default": "false",
          "values": [
            "false",
            "true"
          ]
        },
        {
          "name": "body",
          "type": "string",
          "required": true,
          "max_bytes": 32768
        }
      ],
      "settings": [
        {
          "type": "text",
          "label": "Title",
          "attribute": "title",
          "placeholder": "Details"
        },
        {
          "type": "select",
          "label": "Initially open",
          "attribute": "open"
        },
        {
          "type": "textarea",
          "label": "Content",
          "attribute": "body",
          "placeholder": "Hidden details."
        }
      ],
      "preview": {
        "kind": "details",
        "details": {
          "class": "markdown-details",
          "body_class": "markdown-details-body",
          "title_attribute": "title",
          "open_attribute": "open",
          "body_attribute": "body"
        }
      }
    }
  ]
}
